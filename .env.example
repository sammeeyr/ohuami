# Cube Tech Commerce - Environment Variables Configuration Template
# Copy to .env and provide your actual production credentials

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-cryptographically-secure-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database Connection (Default SQLite for local dev, PostgreSQL for production)
# Example for PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/cubetech_db
DATABASE_URL=sqlite:///db.sqlite3

# Paystack Payment Gateway Integration (Nigeria Default)
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=whsec_replace_with_your_paystack_webhook_secret

# Flutterwave Payment Gateway Integration (Optional Adapter)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-replace_with_your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_with_your_flutterwave_secret_key
FLUTTERWAVE_WEBHOOK_SECRET=flw_whsec_replace_with_your_webhook_secret

# Store Regional Defaults
DEFAULT_CURRENCY=NGN
DEFAULT_CURRENCY_SYMBOL=₦
